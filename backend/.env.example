# ── Auth ─────────────────────────────────────────────────────────────────────
# CHANGE SECRET_KEY before any production deployment
SECRET_KEY=change-me-in-production-use-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── LLM Backend ───────────────────────────────────────────────────────────────
# Set USE_OLLAMA=true to use a local Ollama instance (default)
# Set USE_OLLAMA=false and provide OPENAI_API_KEY to use OpenAI
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Embeddings ────────────────────────────────────────────────────────────────
# Set to true to allow downloading HuggingFace models on first run
# Leave false for offline / air-gapped environments (uses deterministic fallback)
ALLOW_MODEL_DOWNLOADS=false

# ── Adaptive Retrieval ────────────────────────────────────────────────────────
ADAPTIVE_RETRIEVAL_ENABLED=true
# Maximum retrieval retry attempts (bounded to prevent drift)
ADAPTIVE_MAX_ATTEMPTS=2
# Policy: "deterministic" (default, always available) or "laya" (requires LAYA_ENABLED=true)
ADAPTIVE_POLICY=deterministic

# ── Laya Decision Layer (optional) ───────────────────────────────────────────
# Laya is an optional LLM-based decision layer by Convai Innovations.
# Install the 'laya' Python package and set LAYA_ENABLED=true to activate.
# The system always falls back to deterministic policy if Laya is unavailable.
LAYA_ENABLED=false
LAYA_MODEL_VERSION=convaiinnovations/laya
LAYA_TIMEOUT_SECONDS=3.0

# ── Security ──────────────────────────────────────────────────────────────────
# strict_mode=true blocks ambiguous queries; false allows borderline cases
GUARDRAILS_STRICT_MODE=false
# Require Presidio and its spaCy model instead of allowing the regex fallback.
PRESIDIO_STRICT=false
# Minimum Presidio recognizer score treated as a PII finding.
PRESIDIO_SCORE_THRESHOLD=0.4
# DOC_ACCESS_MODE: "open" (all users see all docs) | "user" (per-user scoping)
DOC_ACCESS_MODE=open
# Comma-separated allowed CORS origins (restrict in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
